# Copie para .env.local e preencha. Nunca faça commit de .env.local.
#
# Com o Supabase local (npx supabase start), os valores aparecem em
# `npx supabase status`: API URL, Publishable key, Secret key e DB URL.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Somente servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Somente para testes de banco e scripts (npm run test:db, npm run seed).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Domínio interno usado para mapear usuário -> identificador de login do Supabase Auth.
# Não é e-mail real; não altere depois que houver contas criadas.
AUTH_USERNAME_DOMAIN=usuarios.exemplo.local
